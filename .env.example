# VANTA CINEMA Environment Variables
# TMDB API Read Access Token (v4 auth). Obtain at: https://www.themoviedb.org/settings/api
# NOTE: Because this is a client-side frontend application, values prefixed with VITE_
# are bundled into the client build. Use only dedicated development tokens.
VITE_TMDB_READ_TOKEN=your_tmdb_read_access_token_here
